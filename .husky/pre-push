#!/bin/sh
set -e  # Exit immediately on any failure

echo "🚀 Running full project check before push..."

# Frontend full lint
echo "📦 Linting Frontend..."
cd ecom-frontend || { echo "❌ ecom-frontend folder not found!"; exit 1; }
npm run lint || { echo "❌ Frontend lint failed! Run 'npm run lint:fix' to fix."; exit 1; }
cd ..

# Backend verification (Full Project)
echo "☕ Verifying Backend Formatting..."
./mvnw spotless:check || { echo "❌ Backend formatting check failed! Run './mvnw spotless:apply' to fix."; exit 1; }

echo "✨ All clear! Pushing to remote..."