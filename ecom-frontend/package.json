{
   "name": "ecom-frontend",
   "private": true,
   "version": "0.0.0",
   "type": "module",
   "scripts": {
      "dev": "vite",
      "build": "vite build",
      "lint": "eslint . --max-warnings 0",
      "lint:fix": "eslint . --fix",
      "format": "prettier --write \"src/**/*.{js,jsx,css,html}\"",
      "fix": "echo '🔧 Fixing ESLint issues...' && npm run lint:fix && echo '💅 Formatting files with Prettier...' && npm run format && echo '✅ All issues fixed and formatted!'",
      "preview": "vite preview",
      "prepare": "husky"
   },
   "lint-staged": {
      "*.{js,jsx}": [
         "eslint --fix",
         "prettier --write"
      ],
      "*.{css,html,json}": [
         "prettier --write"
      ]
   },
   "dependencies": {
      "@emotion/react": "^11.14.0",
      "@emotion/styled": "^11.14.1",
      "@headlessui/react": "^2.2.9",
      "@mui/material": "^7.3.8",
      "@mui/x-data-grid": "^9.0.4",
      "@reduxjs/toolkit": "^2.11.2",
      "@stripe/react-stripe-js": "^6.1.0",
      "@stripe/stripe-js": "^9.1.0",
      "@tailwindcss/vite": "^4.2.0",
      "axios": "^1.13.6",
      "classnames": "^2.5.1",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "react-hook-form": "^7.71.2",
      "react-hot-toast": "^2.6.0",
      "react-icons": "^5.5.0",
      "react-loader-spinner": "^8.0.2",
      "react-redux": "^9.2.0",
      "react-router-dom": "^7.13.1",
      "swiper": "^12.1.2",
      "tailwindcss": "^4.2.0"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.1",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^5.1.1",
      "eslint": "^9.39.1",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-react": "^7.37.5",
      "eslint-plugin-react-hooks": "^7.0.1",
      "eslint-plugin-react-refresh": "^0.4.24",
      "globals": "^16.5.0",
      "husky": "^9.1.7",
      "lint-staged": "^17.0.4",
      "prettier": "^3.8.3",
      "vite": "^7.3.1"
   }
}
